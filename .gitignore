.aws-sam/

# Node artifact files
# No trailing slash on node_modules: parallel-agent worktrees symlink it rather
# than reinstalling, and a trailing slash only matches directories, so `git add -A`
# in a worktree would stage the symlink.
node_modules
dist/
coverage/
/bin/

