  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": "^24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidbowland/lull-infrastructure.git"
  },
  "bugs": {
    "url": "https://github.com/davidbowland/lull-infrastructure/issues"
  },
  "homepage": "https://github.com/davidbowland/lull-infrastructure#readme",
  "scripts": {
    "deploy": "./deploy.sh",
    "prepare": "husky || true",
    "lint": "prettier --write .",
    "update": "ncu --target minor --upgrade && npm audit fix --audit-level=none && npm dedupe"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "**/*": [
      "prettier --write --ignore-unknown"
    ]
  }
